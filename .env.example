# ==============================================================================
# GRAAL Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual values
# Never commit the actual .env file to version control
# ==============================================================================

# ------------------------------------------------------------------------------
# Data Folder
# ------------------------------------------------------------------------------
DATA_FOLDER="data"

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Option 1: Single DATABASE_URL (recommended for simplicity)
# For local development (no SSL):
DATABASE_URL="postgresql://graal_user:graal_local_pass@localhost:5432/graal_dev" # pragma: allowlist secret

# For production with SSL, set directly without sslmode parameter:
# DATABASE_URL="postgresql://preprod:<password>@pg-rw:5432/preprod"

# Option 2: Split configuration (use if DATABASE_URL not set)
# Useful for remote deployments where you need to construct the URL dynamically
# DB_HOST="localhost"
# DB_PORT="5432"
# DB_NAME="graal_dev"
# DB_USER="graal_user"
# DB_PASSWORD="graal_local_pass" # pragma: allowlist secret

# Database Connection Pool Settings (optional, defaults shown)
DB_POOL_SIZE="5"              # Number of connections to maintain
DB_POOL_MAX_OVERFLOW="10"     # Maximum overflow connections
DB_POOL_RECYCLE="3600"        # Recycle connections after N seconds (1 hour)
DB_ECHO="false"               # Set to "true" to log all SQL queries (debug only)

# ------------------------------------------------------------------------------
# S3 Configuration (REQUIRED for config file selection and storage)
# ------------------------------------------------------------------------------
S3_BUCKET_ACCESS_KEY="<your_access_key>"
S3_BUCKET_SECRET_KEY="<your_secret_key>"
S3_BUCKET_ENDPOINT="https://s3.gra.io.cloud.ovh.net"
S3_BUCKET_NAME="graal-dev-app"
S3_BUCKET_REGION="gra"
S3_CONFIG_FOLDER="config_graal"
S3_SIMILARITY_DB_FOLDER="similarity_dbs"

# Input file pool and manifests (optional, defaults shown)
S3_INPUT_POOL_FOLDER="input_files/pool"
S3_MANIFEST_FOLDER="input_files/manifests"

# ------------------------------------------------------------------------------
# ProConnect OAuth Configuration
# ------------------------------------------------------------------------------
# ProConnect is the French government identity provider for public sector
# Documentation: https://partenaires.proconnect.gouv.fr/docs/fournisseur-service
#
# For integration testing, use fca.integ01.dev-agentconnect.fr

PROCONNECT_CLIENT_ID="your_client_id_here"
PROCONNECT_CLIENT_SECRET="your_client_secret_here" # pragma: allowlist secret
# Production URL
# PROCONNECT_DISCOVERY_URL="https://auth.agentconnect.gouv.fr/api/v2/.well-known/openid-configuration"
# Integration/testing URL
PROCONNECT_DISCOVERY_URL="https://fca.integ01.dev-agentconnect.fr/api/v2/.well-known/openid-configuration"

PROCONNECT_REDIRECT_URI="http://localhost:8000/api/v1/auth/callback"
PROCONNECT_SCOPES="openid email profile"


# ------------------------------------------------------------------------------
# Session Configuration
# ------------------------------------------------------------------------------
# Session tokens for authenticated users
# IMPORTANT: Generate a secure random key for production using:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

SESSION_SECRET_KEY="generate_a_secure_random_key_here_minimum_32_bytes" # pragma: allowlist secret
SESSION_MAX_AGE="15552000"  # Session lifetime in seconds (6 months)

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
# Frontend URL for redirects after authentication
FRONTEND_URL="http://localhost:5173"

# Cookie security settings
# Set to "true" in production with HTTPS
SECURE_COOKIES="false"

# ------------------------------------------------------------------------------
# LLM Configuration (Albert API)
# ------------------------------------------------------------------------------
# ETALAB_API_KEY="<albert_api_token>"
# ETALAB_BASE_URL="https://albert.api.etalab.gouv.fr/v1"
# ETALAB_MODEL_NAME="meta-llama/Meta-Llama-3.1-70B-Instruct"

# ------------------------------------------------------------------------------
# LLM Configuration (Ollama on OVH)
# ------------------------------------------------------------------------------
# OLLAMA_ENDPOINT="https://<ip_address>.nip.io/api/generate"
# OLLAMA_USER="<user>"
# OLLAMA_PASSWORD="<password>"
# OLLAMA_MODEL_NAME="llama3.1:70b"

# ------------------------------------------------------------------------------
# LLM Configuration (Scaleway)
# ------------------------------------------------------------------------------
# SCALEWAY_BASE_URL="https://<UUID_SCALEWAY>.ifr.fr-par.scaleway.com/v1"
# SCALEWAY_MODEL_NAME="meta/llama-3.3-70b-instruct:bf16"
# SCALEWAY_API_KEY="<API_KEY>"

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
# LOG_LEVEL="INFO"
# WORKERS="4"  # Number of Uvicorn workers for production
